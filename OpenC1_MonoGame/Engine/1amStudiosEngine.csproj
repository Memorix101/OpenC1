<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OneAmEngine</RootNamespace>
    <AssemblyName>1amStudiosEngine</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Properties\AssemblyInfo.cs wird weiterhin von Hand gepflegt. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- Doppelt vorhandene, alte Kopie von GameEngine.cs - war auch vorher nicht im Build. -->
    <Compile Remove="Engine.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.0.1641" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!--
    Der Content dieses Projekts (Engine\Content\Content.mgcb) wird bewusst vom
    Spielprojekt mitgebaut, nicht hier - so landen Engine- und Spiel-Assets
    garantiert im selben Content-Ordner neben der EXE.
  -->

</Project>
