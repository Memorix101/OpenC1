<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>OneAmEngine</RootNamespace>
    <AssemblyName>1amStudiosEngine</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Properties\AssemblyInfo.cs is still maintained by hand. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stale duplicate of GameEngine.cs - it was not part of the build before either. -->
    <Compile Remove="Engine.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.0.1641" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!--
    This project's content (Engine\Content\Content.mgcb) is deliberately built by the
    game project rather than here, so engine and game assets are guaranteed to end up
    in the same Content folder next to the executable.
  -->

</Project>
