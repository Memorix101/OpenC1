<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenC1</RootNamespace>
    <AssemblyName>OpenC1</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Properties\AssemblyInfo.cs is still maintained by hand. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!--
      Mandatory: StillDesign.PhysX.Net.dll is a mixed-mode assembly built for x86.
      On AnyCPU/x64 the loader throws BadImageFormatException on the first PhysX call.
      app.config additionally sets useLegacyV2RuntimeActivationPolicy, because the
      wrapper was built against the 2.0 runtime.
    -->
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <ApplicationIcon>Carmageddon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>

    <!--
      The engine project lives in a subfolder of this one. Without this exclusion the
      SDK glob would compile its sources a second time (among others two AssemblyInfo.cs
      files -> CS0579).
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Engine\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Present in the folder, but never part of the build. -->
    <Compile Remove="Parsers\BitmapChunk.cs" />
    <Compile Remove="Parsers\CarFile.cs" />
    <Compile Remove="Physics\CarObject.cs" />
    <Compile Remove="Physics\PhysicObject.cs" />
    <Compile Remove="Physics\PlaneObject.cs" />
    <Compile Remove="Physics\TriangleMeshObject.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" />
    <None Include="OpenC1Settings.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.0.1641" />
    <!--
      ExcludeAssets="all": we only want the MGCB tool from the package, not its targets -
      those invoke MGCB without roll-forward and fail on the missing netcoreapp3.1
      runtime. ..\MonoGame.Content.targets does the invocation instead.
      GeneratePathProperty still provides $(PkgMonoGame_Content_Builder_Task).
    -->
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.0.1641" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml" />
    <Reference Include="Ionic.Zip.Reduced">
      <HintPath>Lib\Ionic.Zip.Reduced.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>true</Private>
    </Reference>
    <Reference Include="StillDesign.PhysX.Net">
      <HintPath>Lib\StillDesign.PhysX.Net.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The native PhysX 2.8 libraries have to sit next to the executable. -->
  <ItemGroup>
    <None Include="Lib\PhysXLoader.dll" CopyToOutputDirectory="PreserveNewest" Link="PhysXLoader.dll" />
    <None Include="Lib\NxCooking.dll" CopyToOutputDirectory="PreserveNewest" Link="NxCooking.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Engine\1amStudiosEngine.csproj" />
    <!-- Provides the "Microsoft.Xna.Framework" v3.0.0.0 assembly PhysX.Net was built against. -->
    <ProjectReference Include="..\XnaShim\XnaShim.csproj" />
  </ItemGroup>

  <!-- Content of both projects is built here so everything ends up in one Content folder. -->
  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
    <MonoGameContentReference Include="Engine\Content\Content.mgcb" />
  </ItemGroup>

  <Import Project="..\MonoGame.Content.targets" />

</Project>
