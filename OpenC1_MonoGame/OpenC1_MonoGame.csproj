<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenC1</RootNamespace>
    <AssemblyName>OpenC1</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Properties\AssemblyInfo.cs wird weiterhin von Hand gepflegt. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!--
      Pflicht: StillDesign.PhysX.Net.dll ist ein Mixed-Mode-Assembly fuer x86.
      Mit AnyCPU/x64 wirft der Loader beim ersten PhysX-Zugriff BadImageFormatException.
      app.config setzt zusaetzlich useLegacyV2RuntimeActivationPolicy, weil der
      Wrapper gegen die 2.0-Runtime gebaut wurde.
    -->
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <ApplicationIcon>Carmageddon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>

    <!--
      Das Engine-Projekt liegt in einem Unterordner dieses Projekts. Ohne diesen
      Ausschluss wuerde der SDK-Glob dessen Quellen ein zweites Mal mitkompilieren
      (u.a. zwei AssemblyInfo.cs -> CS0579).
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Engine\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Liegen im Ordner, waren aber noch nie Teil des Builds. -->
    <Compile Remove="Parsers\BitmapChunk.cs" />
    <Compile Remove="Parsers\CarFile.cs" />
    <Compile Remove="Physics\CarObject.cs" />
    <Compile Remove="Physics\PhysicObject.cs" />
    <Compile Remove="Physics\PlaneObject.cs" />
    <Compile Remove="Physics\TriangleMeshObject.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" />
    <None Include="OpenC1Settings.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.0.1641" />
    <!--
      ExcludeAssets="all": wir wollen nur das MGCB-Tool aus dem Paket, nicht dessen
      Targets - die rufen MGCB ohne Roll-Forward auf und scheitern an der fehlenden
      netcoreapp3.1-Runtime. Den Aufruf uebernimmt ..\MonoGame.Content.targets.
      GeneratePathProperty liefert trotzdem $(PkgMonoGame_Content_Builder_Task).
    -->
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.0.1641" GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Xml" />
    <Reference Include="Ionic.Zip.Reduced">
      <HintPath>Lib\Ionic.Zip.Reduced.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>true</Private>
    </Reference>
    <Reference Include="StillDesign.PhysX.Net">
      <HintPath>Lib\StillDesign.PhysX.Net.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Native PhysX-2.8-Bibliotheken muessen neben der EXE liegen. -->
  <ItemGroup>
    <None Include="Lib\PhysXLoader.dll" CopyToOutputDirectory="PreserveNewest" Link="PhysXLoader.dll" />
    <None Include="Lib\NxCooking.dll" CopyToOutputDirectory="PreserveNewest" Link="NxCooking.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Engine\1amStudiosEngine.csproj" />
    <!-- Liefert das Assembly "Microsoft.Xna.Framework" v3.0.0.0, gegen das PhysX.Net gebaut wurde. -->
    <ProjectReference Include="..\XnaShim\XnaShim.csproj" />
  </ItemGroup>

  <!-- Content beider Projekte wird hier gebaut, damit alles in einem Content-Ordner landet. -->
  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
    <MonoGameContentReference Include="Engine\Content\Content.mgcb" />
  </ItemGroup>

  <Import Project="..\MonoGame.Content.targets" />

</Project>
