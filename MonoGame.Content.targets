<Project>

  <!--
    Content build for OpenC1.

    Replaces the targets shipped in MonoGame.Content.Builder.Task. Reason: MGCB 3.8.0 is
    a netcoreapp3.1 tool and that runtime is no longer installed on current systems. The
    original targets invoke MGCB without roll-forward and therefore fail with
    "You must install or update .NET". This version sets DOTNET_ROLL_FORWARD, which the
    original targets give no way to do.

    Expects:
      - a PackageReference to MonoGame.Content.Builder.Task with GeneratePathProperty="true"
      - MonoGameContentReference items pointing at .mgcb files
  -->

  <PropertyGroup>
    <MonoGamePlatform Condition="'$(MonoGamePlatform)' == ''">DesktopGL</MonoGamePlatform>
    <!-- "Major" picks the next higher installed major version instead of requiring 3.1. -->
    <MGCBRollForward Condition="'$(MGCBRollForward)' == ''">Major</MGCBRollForward>
    <MGCBDll Condition="'$(MGCBDll)' == ''">$(PkgMonoGame_Content_Builder_Task)\tools\netcoreapp3.1\any\mgcb.dll</MGCBDll>
  </PropertyGroup>

  <!-- Makes the item type selectable in the Visual Studio properties window. -->
  <ItemGroup>
    <AvailableItemName Include="MonoGameContentReference" />
  </ItemGroup>

  <Target Name="BuildMonoGameContent"
          BeforeTargets="BeforeBuild"
          Condition="'@(MonoGameContentReference)' != ''"
          Outputs="%(MonoGameContentReference.Identity)">

    <Error Condition="!Exists('$(MGCBDll)')"
           Text="MGCB nicht gefunden: $(MGCBDll) - fehlt die PackageReference auf MonoGame.Content.Builder.Task mit GeneratePathProperty=&quot;true&quot;?" />

    <PropertyGroup>
      <_MGCBContentDir>%(MonoGameContentReference.RootDir)%(MonoGameContentReference.Directory)</_MGCBContentDir>
      <_MGCBOutDir>$(_MGCBContentDir)bin\$(MonoGamePlatform)</_MGCBOutDir>
      <_MGCBObjDir>$(_MGCBContentDir)obj\$(MonoGamePlatform)</_MGCBObjDir>
      <!--
        Forward slashes for the command line: a trailing backslash in front of the
        closing quote would escape it ("...\Content\" -> broken).
      -->
      <_MGCBContentDirArg>$(_MGCBContentDir.Replace('\','/'))</_MGCBContentDirArg>
      <_MGCBOutDirArg>$(_MGCBOutDir.Replace('\','/'))</_MGCBOutDirArg>
      <_MGCBObjDirArg>$(_MGCBObjDir.Replace('\','/'))</_MGCBObjDirArg>
    </PropertyGroup>

    <!--
      /outputDir und /intermediateDir stehen bewusst NACH /@:, damit sie die Werte
      aus der .mgcb-Datei ueberschreiben. MGCB wertet Optionen in Reihenfolge aus.
    -->
    <Exec Command="dotnet &quot;$(MGCBDll)&quot; /@:&quot;%(MonoGameContentReference.FullPath)&quot; /platform:$(MonoGamePlatform) /outputDir:&quot;$(_MGCBOutDirArg)&quot; /intermediateDir:&quot;$(_MGCBObjDirArg)&quot; /workingDir:&quot;$(_MGCBContentDirArg)&quot;"
          WorkingDirectory="$(_MGCBContentDir)"
          EnvironmentVariables="DOTNET_ROLL_FORWARD=$(MGCBRollForward)" />

    <!--
      Copy via item transform instead of Content items with Link metadata: inside a
      batched target an unqualified %(Filename) would refer to the batching item and
      come out empty. "@(x->'...')" qualifies the metadata unambiguously.
    -->
    <ItemGroup>
      <_MGCBOutputFiles Remove="@(_MGCBOutputFiles)" />
      <_MGCBOutputFiles Include="$(_MGCBOutDir)\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_MGCBOutputFiles)"
          DestinationFiles="@(_MGCBOutputFiles->'$(OutDir)Content\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
