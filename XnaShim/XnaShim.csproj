<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XNA 3.0 compatibility shim.

    StillDesign.PhysX.Net.dll is a mixed-mode C++/CLI assembly (x86, .NET Framework) that
    references "Microsoft.Xna.Framework, Version=3.0.0.0, PublicKeyToken=none".
    It only uses four types from it: Matrix, Plane, Quaternion, Vector3.

    That used to require building an entire copy of the MonoGame sources under the name
    Microsoft.Xna.Framework. Instead, this project produces a tiny assembly of the same
    name that forwards those four types to the official MonoGame.Framework NuGet package
    via TypeForwardedTo.

    Important: the assembly name and version 3.0.0.0 must stay exactly as they are, and
    the assembly must NOT be signed - the reference inside PhysX.Net carries no
    PublicKeyToken.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Microsoft.Xna.Framework</AssemblyName>
    <RootNamespace>OpenC1.XnaShim</RootNamespace>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Version>3.0.0</Version>
    <SignAssembly>false</SignAssembly>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.0.1641" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
